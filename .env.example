# از Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID (Web)
VITE_GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com

# برای نوتیf PWA — با npx @pushforge/builder vapid بسازید
VITE_VAPID_PUBLIC_KEY=

# اختیاری — برای دکمهٔ «باز کردن شیت با گوگل» (Google Picker) در نسخهٔ وب.
# با دسترسی drive.file اپ فقط شیت‌هایی را می‌بیند که خودش ساخته یا کاربر با Picker باز کرده.
# API key: Google Cloud Console > APIs & Services > Credentials > Create credentials > API key
#   محدودیت: API restrictions = Google Picker API، Application restrictions = HTTP referrers
#   (آدرس GitHub Pages و http://localhost:5173/*). اگر خالی بماند، دکمهٔ Picker نمایش داده نمی‌شود.
VITE_GOOGLE_API_KEY=
# شمارهٔ پروژه (Project number، فقط عدد) از Cloud Console > IAM & Admin > Settings
VITE_GOOGLE_APP_ID=
